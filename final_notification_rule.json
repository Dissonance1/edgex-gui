{
  "id": "face_detection_notification",
  "sql": "SELECT CAST(confidence, \"float\") AS confidence, meta(deviceName) AS DeviceName, recognized_names AS Authorized FROM FaceStream WHERE CAST(confidence, \"float\") >= 70",
  "actions": [
    {
      "rest": {
        "url": "http://localhost:59860/api/v3/notification",
        "method": "post",
        "sendSingle": true,
        "dataTemplate": "[{\"apiVersion\":\"v3\",\"notification\":{\"name\":\"FaceDetected\",\"category\":\"FaceAlarm\",\"severity\":\"CRITICAL\",\"content\":\"Face Detected: {{.confidence}}%\",\"sender\":\"EdgeX_Kuiper\",\"description\":\"Person {{.Authorized}} detected\",\"labels\":[\"FaceRecog\"],\"status\":\"NEW\"}}]"
      }
    }
  ]
}